<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <AssemblyName>7Bpencil.MaterialEditor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaponCamoAndStickers\WeaponCamoAndStickers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" />
    <Reference Include="spt-reflection" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="BepInEx" />
    <Reference Include="Comfort" />
    <Reference Include="Comfort.Unity" />
    <Reference Include="Newtonsoft.Json" />
    <Reference Include="Sirenix.Serialization" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.IMGUIModule" />
  </ItemGroup>

  <Target Name="CopyToSPT" AfterTargets="AfterBuild">
    <PropertyGroup>
      <OutDir>$(ProjectDir)..\..\..\..\BepInEx\plugins\7Bpencil.WeaponCamoAndStickers</OutDir>
    </PropertyGroup>
    <Exec Command="mkdir &quot;$(OutDir)&quot;" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OutDir)" />
  </Target>

  <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="'$(Configuration)'=='Release'">
    <PropertyGroup>
      <OutDir>$(ProjectDir)..\..\Stage\BepInEx\plugins\7Bpencil.WeaponCamoAndStickers</OutDir>
    </PropertyGroup>
    <Exec Command="mkdir &quot;$(OutDir)&quot;" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
